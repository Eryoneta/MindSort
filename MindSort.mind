r="0" color="000000" icons="" title="VAR GLOBAIS" x="124" y="-98">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="IMAGE" x="150" y="-98">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="155" y="-97">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="FUNCS" x="124" y="-96">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="VAR GLOBAIS" x="123" y="-94">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="SYMBOLS" x="131" y="-94">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAGS" x="137" y="-94">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="DEFINITION" x="141" y="-94">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="LINK" x="149" y="-94">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="153" y="-93">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="FUNCS" x="123" y="-92">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="VAR GLOBAIS" x="127" y="-90">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="SYMBOLS" x="135" y="-90">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAGS" x="141" y="-90">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="DEFINITION" x="145" y="-90">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="COLOR_SECTION" x="153" y="-90">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="163" y="-89">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="FUNCS" x="127" y="-88">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="125" y="-118">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="128" y="-117">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="132" y="-114">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="135" y="-113">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="133" y="-110">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="136" y="-109">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="127" y="-122">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="130" y="-121">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="125" y="-126">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="128" y="-125">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="128" y="-130">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="131" y="-129">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="124" y="-134">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="127" y="-133">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="TAG" x="122" y="-138">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="125" y="-137">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="VAR GLOBAIS" x="124" y="-114">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="VAR GLOBAIS" x="125" y="-110">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="VARS GLOBAIS" x="130" y="-142">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="DEFINITION" x="139" y="-142">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="ATRIBUTOS" x="147" y="-142">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="MAIN&#10;" x="154" y="-141">		<text/>	</mod>	<mod border="0" color="000000" icons="" title="FUNCS" x="130" y="-140">		<text/>	</mod>	<mod border="0" color="999999" icons="" title="Idéias" x="925" y="-242">		<text>+ Idéias:
- Filosofia: Base sólida, features em plugins!
- Idéias: [74](https://github.com/Eryoneta/MindSort/issues/74).
- Bugs: [75](https://github.com/Eryoneta/MindSort/issues/75), [79](https://github.com/Eryoneta/MindSort/issues/79), [95](https://github.com/Eryoneta/MindSort/issues/95).
- Camada de Rules ([54](https://github.com/Eryoneta/utilities/issues/54)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="MindMarkdown" x="896" y="-242">		<text>* MindMarkdown:
- Idéias: [41](https://github.com/Eryoneta/utilities/issues/41), [40](https://github.com/Eryoneta/utilities/issues/40).
- Textos que começam por `https://` são hyperlinks automaticamente.
. Pode ser configurado para que não o sejam.
- Autodrag ([12](https://github.com/Eryoneta/MindSort/issues/12)).
- Possibilidade de copiar texto como HTML ([8](https://github.com/Eryoneta/utilities/issues/8)).
- Ao selecionar um texto e digitar um caracter especial, o formatar com este ([50](https://github.com/Eryoneta/utilities/issues/50)).
- A formatação deve ser eficiente ([43](https://github.com/Eryoneta/utilities/issues/43))!
- As cores são listadas das com nome mais curto até os com nome mais longo ([37](https://github.com/Eryoneta/utilities/issues/37)).
+ Pré-Format?:
- Logo ao carregar um arquivo, imediatamente começar a salvar todas as formats em uma hashtable. Isso diminúi a lentidão ao abrir um texto.
- Em UndoRedo, o format continua salvo, mesmo com o element deletado. Este apenas se torna inacessível.
. Isso consome muita RAM?
+ Copiar:
- [22](https://github.com/Eryoneta/utilities/issues/22).
- Como HTML.
. Ex.: `\´Texto´` se torna `&lt;i&gt;Texto&lt;/i&gt;`.
- Como Markdown:
. Ex.: `\´Texto´` se torna `\_Texto_`.
- Como texto:
. Ex.: `[Texto\](url)` se torna `Texto (url)`.
- Pode-se copiar apenas um texto formatado específico ([23](https://github.com/Eryoneta/utilities/issues/23)).
. Ex.: Clicar em `\@Texto@` oferece a opção de "Copiar" e "Copiar Texto Escondido".
. Isso remove a necessidade de se copiar o texto todo.
+ Configurações:
- Pèrmitir poder configurar a visibilidade de cada Atribute separadamente ([53](https://github.com/Eryoneta/utilities/issues/53)).
. Ex.: Todos tem `showOnCursorInside`, mas List tem `showOnCursorOnTop`.
  Basicamente, a List apenas mostra seu caractere especial se o cursor estiver acima deste. Isso facilita editar texto em listas.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="RRF-VP" x="920" y="-251">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Básicos" x="934" y="-262">		<text>+ Básicos:
- Modules carregam textos.
- Relations carregam textos.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Inputs" x="959" y="-261">		<text>+ Inputs:
- É possível configurar comandos para ações.
. Ex.: `NewRelation = LEFT\_DOWN+RIGHT_DOWN,LEFT\_DRAG+RIGHT\_DRAG`.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Mouse" x="965" y="-261">		<text>+ Mouse:
- Ao drag, testar quais botões estão pressionados? Isso evitaria softlocks.
- Ao arrastar um block, este é selecionado e movido. Isso evita necessitar o selecionar antes.
- Zoom:
. `SCROLL = zoom`.
. `CTRL+SCROLL = verticalMove`?
. `SHIFT+SCROLL = horizontalMove`?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Anotações?" x="975" y="-242">		<text>+ Anotações?:
- Ter uma janela para anotações?
- Salvar o conteúdo junto?
- Não tem seu conteúdo modificado pelo UndoRedo ([20](https://github.com/Eryoneta/MindSort/issues/20)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Janelas" x="966" y="-242">		<text>+ Janelas:
- A janela principal deve ser normal, sem decorações.
- Quando modificado, mostra um símbolo que indica o fato ([104](https://github.com/Eryoneta/MindSort/issues/104)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Image" x="880" y="-241">		<text>* Image:
- [16](https://github.com/Eryoneta/utilities/issues/16).
+ Format: `![´text´](´path´){´vars´}`:
- Ex.: `![Imagem com largura de 140px e altura de 100px](./img.png){w140h100}`.
- `´text´`:
. Aparece no canto inferior direito, em itálico, pequeno, e cinza.
. Caso não tenha imagem, um ícone aparece, o texto ficando ao lado.
- `´path´`:
. Aponta para uma imagem, vídeo, ou som.
. Pode apontar para mídias online.
. Se não houver valor, nada é desenhado.
- `´vars´`:
. `w´tamanho´`:
  Define a largura em píxels.
  Pode aceitar valores em `%`(De `0\%` até `100\%`).
  Pode aceitar valores em `px`(De `0px` até `3000px`).
  Pode aceitar valores em `un`(De `0un` até `3000un`). Este se refere a altura da linha.
. `h´tamanho´`:
  Define a altura.
. Com apenas 1 `w` ou `h`, o tamanho é calculado proporcional à imagem.
. `\#`:
  Define se a imagem ocupa espaço ou não.
  Se não ocupa espaço, outros elementos podem aparecer em cima deste. Perfeito para uma imagem de fundo.
. `\#´cor´`:
  Define a cor de fundo.
  Ex.: `![](){w100%h100\%\#blue}` cria um fundo colorido.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Bold" x="881" y="-262">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Básicos" x="888" y="-253">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Avançados" x="888" y="-234">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Italic" x="880" y="-260">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Strikethrough" x="875" y="-257">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Highlight" x="878" y="-247">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Subscript" x="878" y="-250">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Superscript" x="877" y="-252">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Underline" x="878" y="-255">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Redact" x="880" y="-245">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Link" x="881" y="-239">		<text>+ Link:
- Bugs: [44](https://github.com/Eryoneta/utilities/issues/44), [69](https://github.com/Eryoneta/utilities/issues/69).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="TextStyle" x="878" y="-237">		<text>+ TextStyle:
- Bugs: [56](https://github.com/Eryoneta/utilities/issues/56).
- Suporta outros estilos dentro ([20](https://github.com/Eryoneta/utilities/issues/20)).
. Ex.: `\:[ RED \:[BLUE]{\#blue} RED ]{\#red}`.
- Estilos dentro já estilizados são negados ([55](https://github.com/Eryoneta/utilities/issues/55)).
. Ex.: Em `\:[Texto \*Texto* Texto\]{\*}`, o negrito dentro é invertido, se tornando texto normal.
- Este deve sobrepor outros estilos, sendo aplicado acima ([57](https://github.com/Eryoneta/utilities/issues/57)).
. Ex.: Dado Highlight, o TextStyle sobrepoe a sua cor.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Anchor" x="880" y="-234">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Citation" x="879" y="-232">		<text>+ Citation:
+ Format: `&gt; ´text´`:
- Pode ser expandido com `|&gt; ´text´`.
- Tem um espaço após a seta. Isso o torna consistente com List.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Line" x="881" y="-230">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="List" x="881" y="-228">		<text>+ List:
- Bugs: [27](https://github.com/Eryoneta/utilities/issues/27), [59](https://github.com/Eryoneta/utilities/issues/59).
- Ao pressionar `HOME`, o cursor é posicionar antes do specialChar!
. Somente com `HOME` novamente, é posicionado no começo.
. Isso permite editar o texto como normal.
- Ao pressionar `ENTER`, a nova linha é já criada como lista.
. `TAB` permite aumentar ou diminuir a hierarquia.
+ Níveis:
- `*`:
. O maior de todos.
. Acrescenta um espaço acima.
. Funciona sozinho.
- `+`:
. Acrescenta um espaço acima.
. Funciona abaixo de `*` ou sozinho.
- `-`:
. Para itens.
. Funciona abaixo de `*`, `+`, ou sozinho.
- `.`:
. Para itens.
. Funciona abaixo de `-`.
- ` `:
. Para itens.
. Funciona abaixo de `.`.
- Adicionar `|` antes de qualquer um permite multilinhas na mesma indentação.
. Este também pode ser usado nos itens de nível abaixo, se conectando a estes.
  Ex.: `|+ ` pode seguir `+ `, `|+ `, `. `, `|. `, `  `, e `| `.
- Adicionar `-` antes de qualquer um abaixa seu nível.
. Ex.: `--` permite criar um `-` abaixo de `+` sem este ser um subitem seu.
- `; `:
. Adiciona um item "fora da hierarquia" ([58](https://github.com/Eryoneta/utilities/issues/58)).
. Renderiza um `o `, desconectado dos outros itens, mas com o mesmo nível que o do item anterior.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Rescale" x="879" y="-226">		<text>* Rescale:
+ Maior:
- É marcado pela quantidade de `\#`.
. Quanto mais, maior.
. Total de 5 níveis.
+ Menor:
- É marcado pela quantidade de `\^`.
. Quanto mais, menor.
. Total de 5 níveis.
- O último nivel é o tamanho 0, resultando em texto invisível.
+ Combinações:
- O maior e menor podem ser combinados para gerar qualquer tamanho.
. Os dois escalam em proporções diferentes.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Mind Map" x="947" y="-261">		<text>* Mind Map:
- Idéias: [39](https://github.com/Eryoneta/utilities/issues/39), [32](https://github.com/Eryoneta/utilities/issues/32).
- Bugs: [21](https://github.com/Eryoneta/utilities/issues/21), [62](https://github.com/Eryoneta/utilities/issues/62), [66](https://github.com/Eryoneta/utilities/issues/66).
- 1UN é o mesmo tamanho de uma linha de texto.
. Isso permite redimencionar um block apenas editando seu title.
- Arrastar um .txt para o map cria um block com o title e o conteúdo deste ([35](https://github.com/Eryoneta/MindSort/issues/35))!
. O mesmo vale para .mind.
- Quando colar um element, adicionar um delay, ou permitir apenas 1 por vez ([26](https://github.com/Eryoneta/utilities/issues/26)).
- Opção de destacar blocks escondidos atrás de outros ([49](https://github.com/Eryoneta/utilities/issues/49))?
. `CTRL+H`.
- Opção de selecionar elements aleatóriamente ([52](https://github.com/Eryoneta/utilities/issues/52))?
. `CTRL+ALT+P` seleciona um block sem parent aleatóriamente.
. `CTRL+ALT+H` seleciona um block escondido aleatóriamente.
- Opção de selecionar parents de selecionados ([48](https://github.com/Eryoneta/utilities/issues/48)).
. `ALT+SHIFT`.
- Deve existir uma ação para cada State.
. Isso inclui desfoco de janela ([34](https://github.com/Eryoneta/utilities/issues/34)).
  Bom para voltar ao State `NORMAL` e evitar softlocks.
- Ao realizar animações, bloquear inputs ([61](https://github.com/Eryoneta/utilities/issues/61)).
. A animação toda deve ser calculada antes e ser finita!
- A fonte escolhida deve ter altura de 2UN ([63](https://github.com/Eryoneta/utilities/issues/63)).
. Ela pode ser escolhida, mas seu tamanho não.
- Destacar e listar elements para facilitar os editar.
. É como se fosse uma aba de um arquivo de texto.
+ Grid Configurável?:
- `GridSize = 1px` e `BlockSize = 16UN` permitiriam um movimento liso, suave.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Auto-Place" x="943" y="-268">		<text>+ Auto-Place:
- Ao criar um block relacionado a outro, pode-se o auto-posicionar.
- Estilos de Formatação:
. Lista: Todos abaixo do parent, na direita ou esquerda.
. Lista Dupla: Todos abaixo do parent, na direita e esquerda.
. Lista Compacta: Todos abaixo do parent, mas tentando centralizar, se houver espaço.
. Lista Linear: Todos diretamente abaixo do parent, centralizados.
. Radial: Todos ao redor do parent, seus childs seguindo sua linha radial.
. Livre: Sem local fixo, livre.
- Permitir auto-posicionar joints também ([71](https://github.com/Eryoneta/utilities/issues/71)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Elements" x="954" y="-272">		<text>+ Elements:
- Cada um tem um id único ([17](https://github.com/Eryoneta/utilities/issues/17)).
. Tem base 64: `\#0fje20fIS2`.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Blocks" x="961" y="-272">		<text>* Blocks:
- Bugs: [11](https://github.com/Eryoneta/utilities/issues/11), [35](https://github.com/Eryoneta/utilities/issues/35), [64](https://github.com/Eryoneta/utilities/issues/64), [68](https://github.com/Eryoneta/utilities/issues/68).
- O title pode ser escondido ([10](https://github.com/Eryoneta/utilities/issues/10)).
. Normalmente é uma linha, mas mostra o texto, se selecionado.
- Animação ([76](https://github.com/Eryoneta/utilities/issues/76)):
. Ao selecionar um, uma animação se inicia em todos os relations conectados. São um pontilhado que indica a direção das conexões.
. Pode ser desativada.
+ Propriedades:
- Tamanhos ([75](https://github.com/Eryoneta/utilities/issues/75)): Varia de 1UN até 8UN.
. O menor pode ter problemas com um relation grosso.
- Cores: Da paleta.
- Estilos de borda: Como o de relation.
- Icones: Um menu de icones.
- Título.
- Texto.
- Grossura ([60](https://github.com/Eryoneta/utilities/issues/60))?: Varia de 1px até 2UN.
+ Configuraçõse:
- Expansão de icones:
. Pode-se escolher como os icones expandem o block: Vertical ou horizontal.
. Verticalmente, a largura permanece a mesma, os icones sendo empilhados.
. Horizontalmente, a altura permanece a mesma, os icones sendo enfileirados.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Relations" x="967" y="-272">		<text>* Relations:
- Relations mais grossas ficam abaixo das mais finas.
- A relation deve terminar exatamente na borda de um block/group ([15](https://github.com/Eryoneta/utilities/issues/15)).
- Opção de o tornar invisível ([13](https://github.com/Eryoneta/utilities/issues/13))?
. Isso facilitaria visualizar tudo.
- Permitir múltiplos entre dois elements ([33](https://github.com/Eryoneta/utilities/issues/33))?
. Como seria lidar com vários sobrepostos?
. Deletar aqueles com a mesma quantidade de joints?
- Ter uma linha fina no meio, da cor do parent, para destacar a conexão ([67](https://github.com/Eryoneta/utilities/issues/67))?
+ Conexões com Block/Group:
- Um block pode ser conectado em vários pontos diferentes ([9](https://github.com/Eryoneta/utilities/issues/9)).
. Caso o element diminua de tamanho, a conexão fica em cima de outras. Quando retornado ao tamanho anterior, a conexão volta ao lugar anterior.
- No meio:
. O elemento todo é destacado.
. A conexão é direta e em qualquer direção, não depende dos lados.
- Em uma lateral:
. A lateral é destacada.
. A conexão se move apenas neste lado.
- Em um ponto:
. São 1 ponto para cada lugar onde a grade "corda" a lateral.
. O ponto é destacado.
. A conexão não se move.
- Em todos os casos, a relation é alinhada com a grade.
. A relation já se move, mostrando como fica se selecionado a opção.
- Zoom?
. Ao focar em uma lateral, esta é destacada e ampliada. Isso permite selecionar os pontos mais facilmente.
+ Relações:
- Unilateral: Um element é pai de outro.
- Bilateral: Um element é pai de outro e vice-versa.
+ Propriedades:
- Estilos de reta: Pontilhado, pontos, retas e pontos, etc.
- Estilos de ponta: Seta, quadrado, seta grossa, etc.
- Grossuras: De fino ao grosso.
- Cores: Da paleta.
- Rotas: Reta, curva, curva com pontos, etc.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Groups" x="960" y="-275">		<text>+ Groups:
- Pode ser redimencionado livremente.
- Pode ser conectado por relations.
- O title fica no canto superior esquerdo.
. Pode ser movido para outros cantos.
. Pode ser posto na vertical.
. É redimencionado conforme a distância.
+ Zona:
- Ao ser movido, move tudo dentro.
. Para ser considerado estar detro, um elemento deve ter mais de sua metade dentro.
+ Propriedades:
- Estilos: A forma como o title e borda são desenhados.
- Cores: Da paleta.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Joints" x="975" y="-272">		<text>+ Joints:
- Bugs: [12](https://github.com/Eryoneta/utilities/issues/12), [65](https://github.com/Eryoneta/utilities/issues/65), [73](https://github.com/Eryoneta/utilities/issues/73).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Selection" x="952" y="-275">		<text>* Selection:
- Seleciona um element apenas se o tiver mais do que a metade.
. Isso facilita não selecionar coisas demais.
- Permitir selecionar apenas um tipo de element ([70](https://github.com/Eryoneta/utilities/issues/70)).
- Ao selecionar elements com texto, não os abrir. Apenas carregar o texto quando finalizar a seleção e houver apenas 1 element selecionado ([72](https://github.com/Eryoneta/utilities/issues/72)).
+ Configurações:
- Modo de inclusão: Inteiro, metade, ou contato.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Chunks" x="958" y="-269">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Cursor" x="948" y="-272">		<text>+ Cursor:
- Quando algo está sendo carregado, se torna o cursor de "carregando" ([88](https://github.com/Eryoneta/MindSort/issues/88)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="UndoRedo" x="936" y="-259">		<text>+ UndoRedo:
- Bugs: [7](https://github.com/Eryoneta/utilities/issues/7), [25](https://github.com/Eryoneta/utilities/issues/25).
- Envolve também as seleções ([51](https://github.com/Eryoneta/utilities/issues/51)).
- Alterar a fonte usada no map também conta ([92](https://github.com/Eryoneta/MindSort/issues/92))!
- Certas ações são várias outras em uma, e devem ser desfeitas juntas ([102](https://github.com/Eryoneta/MindSort/issues/102)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Alinhamentos" x="946" y="-250">		<text>+ Alinhamentos:
- Grade.
. Pode ser mostrado ou escondido.
- Ao mover um block, uma linha o permite alinhar com outros.
. Extende das bordas e do meio.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Teclado" x="965" y="-263">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Touch" x="965" y="-259">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Menus" x="971" y="-246">		<text>* Menus:
- Idéias: [90](https://github.com/Eryoneta/MindSort/issues/90), [103](https://github.com/Eryoneta/MindSort/issues/103).
- Ter uma barra com itens mais acessados, que pode ser customizada ([89](https://github.com/Eryoneta/MindSort/issues/89))?
+ Atalhos:
- Estilos:
. Escritos em um texto discreto.
. Um ponto com um tooltip.
. Escondidos.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Editor de Atalhos" x="977" y="-247">		<text>+ Editor de Atalhos:
- Pressionando uma opção em Configurar, todos os menus e itens tem o campo de atalho editável.
. Se ativada, a opção fica destacada, indicando como parar a edição.
- Ao modificar algo, o Configurações alerta que deve-se salvar a alteração, como se tivesse editado um arquivo.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Tira-Dúvidas" x="977" y="-245">		<text>+ Tira-Dúvidas:
- Pressionando uma opção em Ajuda, todos os menus e itens ganham um ?.
. Se ativada, a opção fica destacada, indicando como parar os ?.
. Se focado, o ? explica o que faz.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Diagrama Geral" x="956" y="-266">		<text>+ Diagrama Geral:
- O programa deve ser adaptável o bastante para poder ser usado como um programa de diagrama genérico.
- Um block pode ter várias formas diferentes, e customizáveis.
. Uma tabela, onde a 1º linha é destacada.
. Uma tabela com rows, onde cada row é separada por uma linha.
. Um boneco.
. Um losango, retângulo, círculo, etc.
- Um relation deve ter vários estilos.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Elemento Composto" x="967" y="-266">		<text>+ Elemento Composto:
- Formado por blocks, relations, joints, e groups, age como um único elemento.
- Isso permite construir elementos mais complexos, pré-prontos.
- Pode ser configurado, ter partes adicionadas ou removidas.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Segurança" x="937" y="-240">		<text>+ Segurança:
- Permitir desabilitar link para arquivos. Se permitido, insiste em avisar quando um .mind possui tais links ([28](https://github.com/Eryoneta/utilities/issues/28)).
. Tais links podem chamar um executável.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Formatação Pessoal" x="899" y="-239">		<text>+ Formatação Pessoal:
- Cada um tem a sua formatação própria.
- Ao criar um arquivo, a formatação é salva junto.
- Ao editar um arquivo com uma formatação diferente, é perguntado o que fazer, substituir tudo ou a seguir.
. Uma opção no menu pode a definir automaticamente.
. É mostrado uma comparação das diferenças entre os formatos.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Janela de Texto" x="969" y="-236">		<text>+ Janela de Texto:
- [21](https://github.com/Eryoneta/MindSort/issues/21), [28](https://github.com/Eryoneta/MindSort/issues/28), [84](https://github.com/Eryoneta/MindSort/issues/84), [97](https://github.com/Eryoneta/MindSort/issues/97), [98](https://github.com/Eryoneta/MindSort/issues/98), [100](https://github.com/Eryoneta/MindSort/issues/100), [105](https://github.com/Eryoneta/MindSort/issues/105), [109](https://github.com/Eryoneta/MindSort/issues/109).
- Não é uma janela real, e sim uma aba.
- Pode ocupar um espaço ou ficar acima de outra aba.
- Botões a permitem rapidamente redimencionar.
. Arrastar a borda também funciona.
+ Titulo:
- Ao mostrar o nome de um block, mostra o path completo desde o Root.
. Considera a relation mais grossa primeiro.
+ Posicionamento:
- Grande = Ocupa o tamanho máximo.
- Metade = Ocupa metade da janela.
- Pequeno = Ocupa o tamanho mínimo.
- Local = Pode ser na direita/esquerda, encima/embaixo ([60](https://github.com/Eryoneta/MindSort/issues/60)).
+ Configurações:
- Mostrar title do block acima do texto.
. Isso facilitaria bastante as coisas.
. Se editado, o próprio title é editado, como se fosse a primeira linha do text.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Mini-Mapa" x="934" y="-265">		<text>+ Mini-Mapa:
- Indica a área da tela.
- Permite clicar em diferentes lugares para transportar a tela.
. O movimento pode ser imediato ou uma animação.
</text>	</mod>	<mod border="0" color="999999" icons="" title="Desenvolvimento" x="914" y="-239">		<text>+ Desenvolvimento:
- Incluir medidores de tempo em certos trechos de código.
. Alguns medem coisas grandes. Outros medem coisas pequenas.
. Podem ser ativados com um argumento.
- Usar MindSort para se referenciar ao código diretamente ([86](https://github.com/Eryoneta/MindSort/issues/86))?
. Seria conveniente!
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Auto-Style" x="938" y="-271">		<text>+ Auto-Style:
- Definir propriedades com base em regras.
- Ex.: Um relation que liga um block que tem mais de 3 childs deve ter grossura 3.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Search" x="959" y="-240">		<text>+ Search:
- Bugs: [5](https://github.com/Eryoneta/MindSort/issues/5), [82](https://github.com/Eryoneta/MindSort/issues/82).
- Quando aberto e tiver elementos selecionados, automaticamente procurar apenas em elementos selecionados ([47](https://github.com/Eryoneta/MindSort/issues/47)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="DotFiles" x="939" y="-230">		<text>+ DotFiles:
- Deve considerar o caso de o arquivo estar bloqueado ([13](https://github.com/Eryoneta/MindSort/issues/13), [96](https://github.com/Eryoneta/MindSort/issues/96)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Arquivos" x="934" y="-237">		<text>+ Arquivos:
- Salvar tudo em um único arquivo .zip, descrito como .mindx ([18](https://github.com/Eryoneta/MindSort/issues/18)).
. Icones, imagens, mídias, todos ficam integrados juntos.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="ContextMenus" x="961" y="-245">		<text>* ContextMenus:
- A Janela de Texto deve ter contextMenu ([14](https://github.com/Eryoneta/MindSort/issues/14))!
. Deve ser navegável com setas ([15](https://github.com/Eryoneta/MindSort/issues/15)).
. Seu menu deve permitir adicionar formatações apenas com o clique ([20](https://github.com/Eryoneta/MindSort/issues/20)).
  Deve permitir a quebra de linha, mostrar caracteres escondidos, etc.
- Ao selecionar um element, as propriedades deste devem já estar selecionadas ([39](https://github.com/Eryoneta/MindSort/issues/39)).
. Caso sejam vários diferentes, são apenas destacados.
- Devem ter icones ([42](https://github.com/Eryoneta/utilities/issues/42)).
+ Opções:
- Inverter vericalmente/horizontalmente todos os elementos selecionados ([77](https://github.com/Eryoneta/MindSort/issues/77)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Configuração" x="929" y="-234">		<text>+ Configuração:
- Deve ser possível escolher o que é configurado por padrão ([46](https://github.com/Eryoneta/MindSort/issues/46)).
- Deve ser possível definir o padrão dos Atributes ([24](https://github.com/Eryoneta/utilities/issues/24)).
. Cores, underscore, fonte, limites, etc.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Icones" x="965" y="-248">		<text>+ Icones:
- [29](https://github.com/Eryoneta/MindSort/issues/29).
- Um icone pode ser um menu, o que permitiria ter variações suas ([31](https://github.com/Eryoneta/utilities/issues/31)).
- Se não encontrar um icone, o marcar como inválido, com um ícone padrão ([30](https://github.com/Eryoneta/utilities/issues/30)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Cores" x="959" y="-248">		<text>* Cores:
- [48](https://github.com/Eryoneta/MindSort/issues/48).
+ Color Picker:
- A seringa mostra a cor que seleciona.
. A ponta é um píxel com a cor invertida, facilmente visível ([106](https://github.com/Eryoneta/MindSort/issues/106)).
- Deve poder ser cancelado ([108](https://github.com/Eryoneta/MindSort/issues/108)).
. `ESC`?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Exportar" x="942" y="-236">		<text>+ Exportar:
- Pode-se exportar o mapa como uma imagem ([70](https://github.com/Eryoneta/MindSort/issues/70)).
- Também há outros formatos ([22](https://github.com/Eryoneta/utilities/issues/22)).
. HTML, em uma lista gigante.
. Markdown, em um formato válido.
  Mas, alguns Atributes não tem equivalentes.
. Texto?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Cor Dinâmica" x="951" y="-253">		<text>+ Cor Dinâmica:
- [71](https://github.com/Eryoneta/MindSort/issues/71).
- Em Exibir, pode ter uma opção de colorir blocks de acordo com a quantidade de texto que possuem.</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Theme" x="929" y="-250">		<text>+ Theme:
- Darkmode ([78](https://github.com/Eryoneta/MindSort/issues/78))?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Relations" x="960" y="-237">		<text>+ Relations:
- De alguma forma, listar os parents e childs conectados, ao selecionar um block ([51](https://github.com/Eryoneta/MindSort/issues/51)).
. Listar a quantidade de joints de um relation ([80](https://github.com/Eryoneta/MindSort/issues/80))?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Histórico de Selecionados" x="974" y="-239">		<text>+ Histórico de Selecionados:
- [81](https://github.com/Eryoneta/MindSort/issues/81).
- Lista todos os texts vistos.
. Isso permite navegar entre estes, de diferentes elements, mais facilmente.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="AutoSave" x="942" y="-233">		<text>+ AutoSave:
- [83](https://github.com/Eryoneta/MindSort/issues/83).
- Cria um arquivo .mind.tmp para cada modificação feita.
. Se encontrar um, tenta o abrir e pergunta se a quer carregar.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="SuperSort" x="915" y="-248">		<text>+ SuperSort:
- [85](https://github.com/Eryoneta/MindSort/issues/85).
- Com um element especial, é possível se referenciar a outro mindmap.
. São visualizados em abas diferentes.
. Este pode ser usado para abrir um arquivo qualquer?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Ícone" x="933" y="-244">		<text>+ Ícone:
- [91](https://github.com/Eryoneta/MindSort/issues/91).
- Deve ser algo que seja simples, mas que pode ser complexo.
. Azul-claro?
. Uma lâmpada?
. Linhas de conexão?
- Uma árvore feita de blocks, relations, e joints?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Ações" x="971" y="-249">		<text>+ Ações:
- Selecionar joints vizinhos sobrepostos ([94](https://github.com/Eryoneta/MindSort/issues/94)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Lógica Separada" x="937" y="-247">		<text>+ Lógica Separada:
- [99](https://github.com/Eryoneta/MindSort/issues/99).
- A lógica que governa os elements deve ser separada do visual, dos inputs.
. Esta deve conseguir funcionar separada, com comandos.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="3DSort" x="911" y="-252">		<text>+ 3DSort:
- [101](https://github.com/Eryoneta/MindSort/issues/101).
- Vários mindmaps em camadas diferentes!
- `CTRL + SCROLL` permite navegar entre elas.
- Vários blocks são tridimencionais, existindo em mais de uma camada.
. São como prédios.
. A altura é configurável.
. Podem ser movidos entre as camadas.
- Pode-se criar relations entre as várias camadas.
- Visão 3D:
. Todas as camadas são visíveis, mas as mais distantes são mais desfocadas.
- Como fazer a seleção 3D?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="HyperSort" x="906" y="-257">		<text>+ HyperSort:
- [107](https://github.com/Eryoneta/MindSort/issues/107).
- Vários trees são conectados em uma grande hyper-tree 4D.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="MacroState" x="911" y="-245">		<text>+ MacroState:
- Cada interface tem um state, e cada state pode ser carregado por um url ([110](https://github.com/Eryoneta/MindSort/issues/110)).
- Isso permitiria carregar o programa ´exatamente´ em um estado desejado!
. Reproduzir bugs, dar contexto para traduções, etc.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Optimização" x="957" y="-256">		<text>+ Optimização:
- Desativar antialias se houver muitos objetos?
. O cálculo deveria ser dinâmico, de acordo com a estabilidade do FPS ([14](https://github.com/Eryoneta/utilities/issues/14)).
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Table" x="880" y="-224">		<text>* Table:
- [18](https://github.com/Eryoneta/utilities/issues/18).
+ Format: `|´item1´|´item1´|`:
- `-`:
. Define as células abaixo. Deve ficar abaixo do cabeçário.
. Ex.: `|Item1|Item2|Item3|` seguido por `|-|--|` resulta em uma tabela com 3 cabeçários, mas 2 colunas abaixo.
  Hum. Melhorar.
- Um texto é centralizado, mas pode ser afetado pelas Anchors.
. Ex.: `|:-Texto na esquerda|Texto|`.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Interações" x="887" y="-242">		<text>* Interações:
- [19](https://github.com/Eryoneta/utilities/issues/19).
- Vários Atributos podem ser combinados.
+ Rescale:
- Line:
. `\#===` torna a linha mais grossa.
. Varia de 0 até a altura da linha.
+ Anchor:
- TextStyle, Atributos básicos, Link, Rescale:
. Os posiciona.
- Image:
. `:-![Texto](./img.png)-:` centraliza a imagem.
- List:
. `* Texto-:` cria uma lista com o texto na direita.
. `* :-Texto-:` centraliza o texto.
- Line:
. `:-===` cria uma linha com o centro ancorado na esquerda.
. Funciona apenas para certos estilos de linha, os que possuem decoração central.
. Rescale: `:-\#===` cria uma linha grossa ancorada na esquerda.
+ Citation:
- TextStyle, Atributos básicos, Link, Rescale:
. Os coloca em um bloco.
- Anchor:
. `&gt; :-Texto-:` cria um bloco com o texto centralizado.
- List:
. `&gt; * Texto` cria uma lista dentro de um bloco.
- Line:
. `&gt; ===` cria uma linha dentro de um bloco.
- Image:
. `&gt; ![Texto](./img.png)` cria uma imagem em um bloco.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Cor?" x="869" y="-233">		<text>+ Cor?:
- Opção de editar a cor do format ([47](https://github.com/Eryoneta/utilities/issues/47))?
- Ex.: `* {\#blue}` adiciona cor no item e seus subitens.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Setas?" x="887" y="-226">		<text>+ Setas?:
- [46](https://github.com/Eryoneta/utilities/issues/46).
- `{{´setas´}}` permite criar uma grade com setas e linhas.
. `{{-&gt;}}` é uma seta para a direita.
. `-` são linhas.
. `&gt;`, `&lt;`, `\^`, `v` são setas.
. `L`, `T`, `J`, e `I` são dobras.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Icon?" x="891" y="-229">		<text>+ Icon?:
- [45](https://github.com/Eryoneta/utilities/issues/45).
- `{{´iconName´}}` desenha um icone.
- Não é mais simples usar Image?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Tags?" x="896" y="-232">		<text>+ Tags?:
- Como em Obsidian?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Task?" x="897" y="-229">		<text>+ Task?:
- Como em Obsidian?
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Metalinks?" x="896" y="-235">		<text>+ Metalinks?:
- [38](https://github.com/Eryoneta/utilities/issues/38).
- Seriam `[[´elementID´|´text´]]`.
- Ou usar `[´text´\](´elementID´)`?
. Se sem texto, mostra o title do element.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Commands" x="936" y="-268">		<text>+ Commands:
- [36](https://github.com/Eryoneta/utilities/issues/36).
- Um block pode carregar comandos.
. Seu title pode ter um botão que permite executar tais comandos.
- Baseado em JS?
. Teria uma API que permitiria escutar e controlar tudo!
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Style?" x="871" y="-239">		<text>+ Style?:
- [29](https://github.com/Eryoneta/utilities/issues/29).
- `:[´text´\]{´vars´}` pode ser usado para muito mais do que estilo de texto.
- `*`, `+`, `-`, `.`, ` ` permitem tornar todas as linhas listas.
. Permite controlar a quantidade: `+2-3.` aplica 2 `+ `, 3 `- `, e n `. `.
- `&gt;` torna tudo um Citation.
- `:-` ancora.
- `\\` permite escapar todos os caracteres.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Perímetro" x="933" y="-255">		<text>+ Perímetro:
- [74](https://github.com/Eryoneta/utilities/issues/74).
- Configurado por uma opção, se trata de um quadrado que é desenhado ao redor de todo o mindmap.
. Este permite esclarecer onde todos os elements estão.
. Toda a área fora é escurecida.
</text>	</mod>	<mod border="0" color="999999" icons="" title="Planos" x="925" y="-292">		<text>+ Esquema:
</text>	</mod>	<mod border="0" color="999999" icons="" title="Partes" x="925" y="-303">		<text>+ Partes:
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="MainWindow" x="923" y="-318">		<text>+ MainWindow:
- Carrega a lógica da janela.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="MindMap" x="924" y="-341">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="TabGrid" x="924" y="-321">		<text>+ TabGrid:
- Carrega uma grade onde Tabs podem ser abertas.
. Permite os organizar em blocos(Ex.: VSCode).
- É a interface da janela.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Tab" x="926" y="-324">		<text>+ Tab:
- Tem uma aba e um conteúdo.
- Um toggle o permite ficar acima de outros.</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Block" x="940" y="-344">		<text>* Block:
- O title pode ser escondido.
. Normalmente é uma linha, mas mostra o texto, se selecionado.
- Animação:
. Ao selecionar um, uma animação se inicia em todos os relations conectados. São um pontilhado que indica a direção das conexões.
. Pode ser desativada.
+ Propriedades:
- Tamanhos: Varia de 1UN até 8UN.
. O menor pode ter problemas com um relation grosso.
- Cores: Da paleta.
- Estilos de borda: Como o de relation.
- Icones: Um menu de icones.
- Título.
- Texto.
- Grossura da borda: Varia de 1px até 2UN.
+ Configurações:
- Expansão de icones:
. Pode-se escolher como os icones expandem o block: Vertical ou horizontal.
. Verticalmente, a largura permanece a mesma, os icones sendo empilhados.
. Horizontalmente, a altura permanece a mesma, os icones sendo enfileirados.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Relation" x="939" y="-352">		<text>* Relations:
- Relations mais grossas ficam abaixo das mais finas.
- A relation deve terminar exatamente na borda de um block/group.
- Opção de o tornar invisível.
. Isso facilitaria visualizar tudo.
. É a largura 0.
- Permitir múltiplos entre dois elements.
. É um dos elements que é destacado quando se procura por elements sobrepostos.
+ Conexões com Block/Group:
- Um block pode ser conectado em vários pontos diferentes.
. Caso o element diminua de tamanho, a conexão fica em cima de outras. Quando retornado ao tamanho anterior, a conexão volta ao lugar anterior.
- No meio:
. O elemento todo é destacado.
. A conexão é direta e em qualquer direção, não depende dos lados.
- Em uma lateral:
. A lateral é destacada.
. A conexão se move apenas neste lado.
- Em um ponto:
. São 1 ponto para cada lugar onde a grade "corda" a lateral.
. O ponto é destacado.
. A conexão não se move.
- Em todos os casos, a relation é alinhada com a grade.
. A relation já se move, mostrando como fica se selecionado a opção.
- Zoom:
. Ao focar em uma lateral, esta é destacada e ampliada. Isso permite selecionar os pontos mais facilmente.
+ Relações:
- Unilateral: Um element é pai de outro.
- Bilateral: Um element é pai de outro e vice-versa.
+ Propriedades:
- Estilos de reta: Pontilhado, pontos, retas e pontos, etc.
- Estilos de ponta: Seta, quadrado, seta grossa, etc.
- Grossuras: De fino ao grosso.
- Cores: Da paleta.
- Rotas: Reta, curva, curva com pontos, etc.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Joint" x="953" y="-352">		<text>* Joint:
+ Propriedades:
- Estilos: Quadrado, círculo, invisível, etc.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Group" x="925" y="-350">		<text>+ Group:
- Pode ser redimencionado livremente.
. Em suas bordas, pode ser arrastado, o redimencionando.
- Pode ser conectado por relations.
- O title fica no canto superior esquerdo.
. Pode ser movido para outros cantos.
. Pode ser posto na vertical.
. É redimencionado conforme a distância.
+ Zona:
- Ao ser movido, move tudo dentro.
. Para ser considerado estar detro, um elemento deve ter mais de sua metade dentro.
+ Propriedades:
- Estilos: A forma como o title e borda são desenhados.
- Cores: Da paleta.
+ Configurações:
- Redimencionar ou não o title.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Chunk" x="925" y="-344">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Selection" x="916" y="-339">		<text>+ Selection:
- Seleciona um element apenas se o tiver mais do que a metade.
. Isso facilita não selecionar coisas demais.
- Permitir selecionar apenas um tipo de element.
- Ao selecionar elements com texto, não os abrir. Apenas carregar o texto quando finalizar a seleção e houver apenas 1 element selecionado.
+ Configurações:
- Modo de inclusão: Inteiro, metade, ou contato.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Cursor" x="918" y="-343">		<text>+ Cursor:
- Quando algo está sendo carregado, se torna o cursor de "carregando".
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Segment" x="939" y="-355">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Tip" x="946" y="-355">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Border" x="946" y="-344">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Search" x="957" y="-318">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="ConfigurationWindow" x="947" y="-303">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Text" x="900" y="-324">		<text>+ Text:
- Pode ter várias instâncias.
. `CTRL+LEFT_CLICK` em um element abre uma instância ligada diretamente a aquele element.
. O título indica o fato.
  Um toggle (Icone de link) o faz se ligar ao element selecionado.
. `RIGHT_CLICK` abre um contextMenu que permite selecionar a opção de duplicar a aba.
- Seu conteúdo é ditado pelo element selecionado.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="FontChooserWindow" x="947" y="-313">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="ContextMindMenu" x="903" y="-341">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="ColorPick" x="895" y="-339">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="IconPick" x="896" y="-342">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="MainMenu" x="916" y="-318">		<text>+ MainMenu:
- O menu principal.
- Tem 2 camadas:
. Menus, com todas as opções existentes.
. Atalhos, com ícones para opções úteis.
  Pode ser customizado.
- Fica no topo.
. Os botões de janela ficam ao lado.
. Na direita, fica a barra de pesquisa.
. Na esquerda, fica o ícone.
. Quando tem pouco espaço, o ícone e menu é colapsado dentro de um ícone.</text>	</mod>	<mod border="0" color="999999" icons="" title="Plugins" x="906" y="-292">		<text>+ Plugins:
- Existem os core, mas mais podem ser inclusos.
- Podem ser inclusos localmente, ou online(Futuramente).
- Existem 2 tipos: Mods e Plugins.
. Mods alteram o programa. São perigosos.
  Devem ser usados apenas se Plugins não tiverem poder o bastante.
. Plugins alteram apenas a página atual.
  Uma API interna cuida das permissões e concede acesso a features.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="MiniMap" x="903" y="-298">		<text>+ MiniMap:
- Um mini-mapa que aparece em um dos cantos da tela.
. Pode ser sua posição configurada.
  Pode ficar em um dos cantos, ou até ser movida.
  Pode "se desviar" do cursor.
- Mostra a posição da tela em relação ao mapa completo.
. O mapa completo é definido pelos elements nos cantos mais extremos.
- Pode ser clicada, posicionando a posição da tela.
. O posicionamento pode ser direto ou em uma animação.
</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="TextMenu" x="890" y="-324">		<text>+ MainMenu:
- Tem 2 camadas:
. Menus, com todas as opções existentes.
. Atalhos, com ícones para opções úteis.
  Pode ser customizado.
</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Itens" x="705" y="-318">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Arquivos" x="706" y="-313">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Novo..." x="710" y="-311">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Editar" x="724" y="-313">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Selecionar" x="754" y="-313">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Abrir..." x="710" y="-307">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Abrir Recente" x="710" y="-305">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="---" x="710" y="-309">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="..." x="716" y="-303">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Salvar" x="710" y="-299">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="---" x="710" y="-301">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Salvar Como..." x="710" y="-297">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="---" x="710" y="-291">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Sair" x="710" y="-289">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Exportar Como..." x="710" y="-293">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="---" x="710" y="-295">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Desfazer" x="727" y="-311">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Refazer" x="727" y="-309">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="---" x="727" y="-307">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Bloco" x="727" y="-305">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Relação" x="727" y="-293">		<text/>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Grupo" x="727" y="-289">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Editar Título" x="730" y="-303">		<text>+ Editar Título:
- Abre o editor de título do Módulo.
- F2
	editTitulo();</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Relacionar" x="727" y="-275">		<text>+ Relacionar:
- Inicia o modo de relacionar Módulos.
- Ctrl-R
	setModo(TO_CONNECT);</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="---" x="730" y="-301">		<text/>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Criar Relacionados aos Selecionados" x="730" y="-299">		<text>+ Criar Relacionados aos Selecionados:
- Cria um Módulo, descendente dos selecionados.
- Ctrl+Alt-G
	createModRelacionado();</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Relacionar Selecionados" x="730" y="-297">		<text>+ Relacionar Selecionados:
- Inicia uma relação, relacionando os selecionados.
- Ctrl+Alt-R
	startRelation();</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Excluir Selecionados" x="730" y="-295">		<text>+ Excluir Selecionados:
- Exclui os Módulos selecionados.
- Ctrl+Alt-D
	deleteMods();</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Selecionar Sem Antecedentes" x="759" y="-301">		<text>+ Selecionar Sem Antecedentes:
- Seleciona todos os Módulos sem pais.
- Ctrl-P
	selectModSemPai();</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Inverter Relação" x="731" y="-291">		<text>+ Inverter Relação:
- Inverte a relação de Módulo-pai e Módulo-son.
	invertCox();</text>	</mod>	<mod border="0" color="FFFFFF" icons="" title="Criar" x="727" y="-277">		<text>+ Criar:
- Inicia o modo de criar Objetos.
- Ctrl-G
	setModo(TO_CREATE);</text>	</mod>	<mod border="0" color="DCDCDC" icons="" title="Mover" x="727" y="-271">		<text>+ Mover:
